#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source /usr/share/yunohost/helpers

ynh_print_info "Declaring files to be backed up..."

#=================================================
# BACKUP THE APP MAIN DIR
#=================================================

ynh_backup "$install_dir"

#=================================================
# BACKUP THE DATA DIR
#=================================================

ynh_backup "$data_dir"

#=================================================
# BACKUP SYSTEM CONFIGURATION
#=================================================

# Backup the PHP-FPM configuration
ynh_backup "/etc/php/$php_version/fpm/pool.d/$app.conf"

# Backup the NGINX configuration
ynh_backup "/etc/nginx/conf.d/$domain.d/$app.conf"

#=================================================
# BACKUP VARIOUS FILES
#=================================================

ynh_backup "/etc/cron.d/$app"

#=================================================
# BACKUP THE DATABASE
#=================================================

# A legacy PostgreSQL instance that has not yet been migrated to MariaDB is
# dumped from PostgreSQL; every other (migrated or fresh) instance from MariaDB.
if [ "${database:-mariadb}" == "postgresql" ]; then
    ynh_print_info "Backing up the PostgreSQL database..."
    ynh_psql_dump_db > db.sql
else
    ynh_print_info "Backing up the MariaDB database..."
    ynh_mysql_dump_db > db.sql
fi

#=================================================
# END OF SCRIPT
#=================================================

ynh_print_info "Backup script completed for $app. (YunoHost will then actually copy those files to the archive)."
