#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

ynh_app_setting_set_default --key=php_upload_max_filesize --value=1G
ynh_app_setting_set_default --key=php_memory_limit --value=256M
ynh_app_setting_set_default --key=php_max_execution_time --value=300
ynh_app_setting_set_default --key=php_max_input_vars --value=5000
ynh_app_setting_set_default --key=cron_interval --value=15

if [ -z "${admin:-}" ]; then
	ynh_die "This app can't be upgraded from a very old version of the package. Please remove and reinstall Moodle"
fi

ynh_app_setting_set_default --key=site_name --value="YunoHost"

# Instances installed before the MariaDB switch have no "database" setting and
# are still running on PostgreSQL. Default them to postgresql so the migration
# block below knows they still need to be moved to MariaDB.
ynh_app_setting_set_default --key=database --value="postgresql"

#=================================================
# CHECK SYSTEM REQUIREMENTS
#=================================================
ynh_script_progression "Checking system requirements..."

# The package now uses MariaDB (the migration below moves any legacy PostgreSQL
# instance onto it), so ensure MariaDB is recent enough for this Moodle release.
# Moodle 4.1+ / 5.x require MariaDB >= 10.6.7.
required_maria="10.6.7"
maria_version=$(mysql -B <<< "SELECT VERSION();" | tail -n1 | grep -oE '^[0-9]+\.[0-9]+\.[0-9]+' | head -1)
if [ -z "$maria_version" ] || [ "$(printf '%s\n%s\n' "$required_maria" "$maria_version" | sort -V | head -n1)" != "$required_maria" ]; then
    ynh_die "This Moodle version requires MariaDB ${required_maria}+, but this server runs MariaDB ${maria_version:-unknown}."
fi

#=================================================
# MIGRATE THE DATABASE FROM POSTGRESQL TO MARIADB
#=================================================

# One-time, in-place migration for instances installed before the MariaDB
# switch. It runs while the *old* Moodle code and PostgreSQL config.php are still
# in place (before ynh_setup_source below), so Moodle bootstraps consistently
# against PostgreSQL and the data is copied 1:1 into the MariaDB database that
# the "database" resource has already provisioned.
#
# Fail-safe: if anything goes wrong the script aborts (ynh_abort_if_errors)
# before config.php is switched or the PostgreSQL database is dropped, leaving a
# fully working PostgreSQL instance behind. A safety dump is also kept in the
# (backed-up) data directory.
#
# NOTE: this migration path exercises Moodle's tool_dbtransfer internals via
# conf/dbtransfer_cli.php and should be validated on a staging instance before
# being relied upon in production (see doc/migration-spike/MIGRATION_SPIKE.md).
#
# Resumability: config.php is the source of truth for the *actual* backend
# in use. We only run the (destructive) target reset + transfer while config.php
# still points at PostgreSQL. If a previous run was interrupted after switching
# config.php to MariaDB but before recording database=mariadb, we take the
# reconcile branch instead of re-running the transfer, so the already-populated
# MariaDB database is never wiped.

# Only disabled again at the end of the script if *we* enabled it here, so an
# administrator's pre-existing maintenance mode is preserved.
maintenance_toggled_by_upgrade=0

if [ "$database" == "postgresql" ] && grep -qE "dbtype[[:space:]]*=[[:space:]]*'mariadb'" "$install_dir/config.php" 2>/dev/null; then
    # A previous interrupted run already transferred the data and switched
    # config.php to MariaDB. Finish the bookkeeping without touching the
    # (already-populated) MariaDB database.
    ynh_script_progression "Finalizing a previously interrupted PostgreSQL -> MariaDB migration..."

    if ynh_psql_database_exists "$db_name"; then
        ynh_psql_dump_db "$db_name" > "$data_dir/pre-mariadb-migration.pgsql.sql"
        ynh_psql_drop_db "$db_name"
    fi
    ynh_psql_user_exists "$db_user" && ynh_psql_drop_user "$db_user" || true

    database="mariadb"
    ynh_app_setting_set --key=database --value="mariadb"

elif [ "$database" == "postgresql" ] && ynh_psql_database_exists "$db_name"; then
    ynh_script_progression "Migrating the database from PostgreSQL to MariaDB..."

    # Safety net: keep a PostgreSQL dump in the data dir (included in backups).
    ynh_psql_dump_db "$db_name" > "$data_dir/pre-mariadb-migration.pgsql.sql"

    # Suspend the Moodle cron job for the duration of the copy. Maintenance mode
    # only blocks web requests; the CLI cron (conf/cron) could still write to
    # PostgreSQL mid-transfer and yield a cross-table-inconsistent MariaDB
    # snapshot. The cron file is regenerated below (REAPPLY SYSTEM CONFIGURATIONS).
    ynh_safe_rm "/etc/cron.d/$app"

    # Put the site in maintenance mode during the transfer (old code, still on
    # PostgreSQL). Record whether it was already on (either the maintenance_enabled
    # config flag or the legacy climaintenance.html file) so we don't clobber an
    # administrator's pre-existing maintenance state at the end of the script.
    maintenance_prior=$(sudo --login --user=postgres psql -tAc "SELECT value FROM public.mdl_config WHERE name='maintenance_enabled'" "$db_name" 2>/dev/null | tr -d '[:space:]')
    if { [ -z "$maintenance_prior" ] || [ "$maintenance_prior" == "0" ]; } && [ ! -f "$data_dir/climaintenance.html" ]; then
        php${php_version} "$install_dir/admin/cli/maintenance.php" --enable
        maintenance_toggled_by_upgrade=1
    fi

    # Reset the target to a clean, empty utf8mb4 database. The resource created
    # it with the server default charset, and dbtransfer refuses a non-empty
    # target, so recreating it here also makes a retried transfer idempotent.
    # This is safe only because config.php still points at PostgreSQL (checked
    # above), so the source data lives in PostgreSQL, not here.
    # Database-level grants survive a DROP/CREATE of the same name, so db_user
    # keeps its privileges.
    ynh_mysql_db_shell "mysql" <<< "DROP DATABASE IF EXISTS \`$db_name\`; CREATE DATABASE \`$db_name\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"

    # Drive Moodle's tool_dbtransfer to copy PostgreSQL -> MariaDB. The target
    # user/password already match db_user/db_pwd (reused by the resource).
    cp -f "$YNH_APP_BASEDIR/conf/dbtransfer_cli.php" "$install_dir/dbtransfer_cli.php"
    php${php_version} "$install_dir/dbtransfer_cli.php" \
        --configphp="$install_dir/config.php" \
        --target-dbtype="mariadb" \
        --target-dbhost="localhost" \
        --target-dbname="$db_name" \
        --target-dbuser="$db_user" \
        --target-dbpass="$db_pwd" \
        --target-prefix="mdl_"
    ynh_safe_rm "$install_dir/dbtransfer_cli.php"

    # Verify the MariaDB database now holds Moodle tables before switching over.
    table_count=$(ynh_mysql_db_shell "$db_name" <<< "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='$db_name' AND table_name LIKE 'mdl\_%';" | tail -n1)
    if [ -z "$table_count" ] || [ "$table_count" -lt 1 ]; then
        ynh_die "Database migration to MariaDB failed: no Moodle tables found in the MariaDB database. The site is unchanged and still uses PostgreSQL."
    fi

    # Point Moodle at MariaDB by regenerating config.php from the template. From
    # this point a resumed run takes the reconcile branch above (never the reset).
    # config.php contains PHP's __DIR__ constant; ynh_config_add treats __DIR__ as
    # a placeholder, so define $dir="__DIR__" to substitute it back to itself
    # (same workaround as scripts/change_url).
    dir="__DIR__"
    if [ "${path:-/}" == "/" ]; then
        ynh_config_add --template="config-domain.php" --destination="$install_dir/config.php"
    else
        ynh_config_add --template="config-path.php" --destination="$install_dir/config.php"
    fi
    ynh_store_file_checksum "$install_dir/config.php"
    chmod 600 "$install_dir/config.php"
    chown "$app:$app" "$install_dir/config.php"

    # Drop the now-migrated PostgreSQL database and user. The safety dump above
    # and the pre-upgrade backup still hold the PostgreSQL data.
    ynh_psql_drop_db "$db_name"
    ynh_psql_user_exists "$db_user" && ynh_psql_drop_user "$db_user" || true

    # Record MariaDB as the backend so later runs skip this block and APT can
    # autoremove PostgreSQL on the next upgrade.
    database="mariadb"
    ynh_app_setting_set --key=database --value="mariadb"
fi

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

# Download, check integrity, uncompress and patch the source from manifest.toml
ynh_setup_source --dest_dir="$install_dir" --full_replace --keep="config.php"

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_phpfpm

ynh_config_add_nginx

ynh_config_add --template="cron" --destination="/etc/cron.d/$app"

#=================================================
# ACTIVATE LDAP SUPPORT
#=================================================
ynh_script_progression "Activate LDAP support..."

_moodle_configure_ldap

#=================================================
# RUN DATABASE MIGRATIONS
#=================================================
ynh_script_progression "Running Moodle database migrations..."

env -i HOME=/root PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    php${php_version} -d max_input_vars=5000 "$install_dir/admin/cli/upgrade.php" --non-interactive

env -i HOME=/root PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    php${php_version} "$install_dir/admin/cli/purge_caches.php"

# Lift maintenance mode only if the migration block above turned it on, so an
# administrator who intentionally enabled maintenance before upgrading (or a
# non-migration upgrade that never touched it) keeps their chosen state.
if [ "${maintenance_toggled_by_upgrade:-0}" == "1" ]; then
    php${php_version} "$install_dir/admin/cli/maintenance.php" --disable
fi

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
